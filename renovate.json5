{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":semanticCommits",
  ],
  timezone: "Asia/Tokyo",
  // ignore pyproject.toml, .python-version, Dockerfile
  enabledManagers: ["github-actions", "custom.regex"],
  semanticCommitType: "chore",
  semanticCommitScope: "deps",
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^ansible/vars/versions\\.yaml$/"],
      matchStrings: [
        "repo: (?<depName>\\S+)\\s+version: \"(?<currentValue>[^\"]+)\"",
      ],
      datasourceTemplate: "github-releases",
      versioningTemplate: "loose",
    },
  ],
  packageRules: [
    {
      // patch updates are not worth a PR for these tools. minor and major are
      // still opened
      matchUpdateTypes: ["patch"],
      enabled: false,
    },
    {
      matchManagers: ["custom.regex"],
      semanticCommitScope: "ansible",
      commitMessageTopic: "{{depName}}",
    },
  ],
}
